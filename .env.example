# Copy this file to .env and fill in the blanks:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# ---- Local server -------------------------------------------------------------
# Port the Express app listens on. The ngrok tunnel must forward to this same port.
PORT=3000
NODE_ENV=development

# ---- Africa's Talking ---------------------------------------------------------
# Sandbox credentials: https://account.africastalking.com/apps/sandbox
# The USSD callback does NOT need these - AT POSTs to your URL and you return text.
# They are required for the future SMS confirmations and mobile money STK push.
AT_USERNAME=sandbox
AT_API_KEY=
AT_ENVIRONMENT=sandbox

# The USSD service code you created in the AT sandbox, e.g. *123# -> service code "123"
AT_SHORTCODE=
# Public base URL that AT's servers POST to. Must be HTTPS and publicly reachable.
# For local development this is your ngrok forwarding URL with no trailing path.
AT_CALLBACK_BASE_URL=https://deafening-generic-chemist.ngrok-free.dev

# ---- ngrok --------------------------------------------------------------------
# Optional. ngrok's reserved domain gives a fixed URL, but it only works on a
# network that can reach ngrok's edge (the office network could not).
# Set NGROK_DOMAIN to a working reserved domain to use `pnpm tunnel:ngrok`.
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# ---- Cloudflare named tunnel ---------------------------------------------------
# The most robust option: one hostname that never changes, so the AT callback URL
# is set once. Needs a domain you own, added to a free Cloudflare account.
# See the README for the one time setup, then fill these in.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_HOSTNAME=

# ---- Product ------------------------------------------------------------------
# Public base URL for the terms and conditions linked in the purchase confirmation.
TERMS_URL=https://oldmutual.co.ug/your-mutual-friend/terms

# Idle time after which a USSD session is discarded from memory. AT sessions rarely
# run past a few minutes, so 30 leaves plenty of headroom.
SESSION_TTL_MINUTES=30
